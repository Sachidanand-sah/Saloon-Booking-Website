# Copy to .env and adjust.
NODE_ENV=development
PORT=5000

# Postgres connection. `npm run db:local` starts one on port 5433 with these credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/salon?schema=public

# Use long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Salon opening hours are interpreted in this IANA time zone.
SALON_TIMEZONE=Asia/Kathmandu
CURRENCY=NPR
SLOT_STEP_MINS=15
MIN_LEAD_MINS=60
BOOKING_WINDOW_DAYS=90
# Customers can cancel or reschedule up to this many minutes before the appointment.
CANCEL_CUTOFF_MINS=120
# Login/signup attempts per client IP per 15 minutes (raise locally when running e2e tests).
AUTH_RATE_LIMIT=20
