{
  "expo": {
    "name": "Lalima Beauty",
    "slug": "lalima-beauty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "lalima",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2a1626"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lalimabeauty.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2a1626"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lalimabeauty.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#b76e79"
        }
      ],
      "expo-asset"
    ],
    "primaryColor": "#2a1626"
  }
}
