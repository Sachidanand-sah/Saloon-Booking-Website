# Where the phone reaches the API and website. Use your computer's LAN IP (run `ipconfig`),
# not localhost: the phone is a different device.
EXPO_PUBLIC_API_URL=http://192.168.1.72:5000/api
# Used to load images bundled with the website (service, branch and product photos).
EXPO_PUBLIC_SITE_URL=http://192.168.1.72:3000
